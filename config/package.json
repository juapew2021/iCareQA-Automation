{
  "devDependencies": {
    "@wdio/allure-reporter": "^9.22.0",
    "@wdio/appium-service": "^9.23.0",
    "@wdio/cli": "^9.23.2",
    "@wdio/cucumber-framework": "^9.23.0",
    "@wdio/local-runner": "^9.23.0",
    "@wdio/spec-reporter": "^9.20.0",
    "@wdio/visual-service": "^9.1.0",
    "appium": "^3.1.2",
    "appium-uiautomator2-driver": "^6.7.8"
  },
  "scripts": {
    "wdio": "wdio run ./wdio.conf.js",
    "test:open": "wdio run wdio.conf.js --cucumberOpts.tagExpression=@open",
    "test:onboarding": "wdio run wdio.conf.js --cucumberOpts.tagExpression=@onboarding",
    "test:login": "wdio run wdio.conf.js --cucumberOpts.tagExpression=@login",
    "test:registration": "wdio run wdio.conf.js --cucumberOpts.tagExpression=@registration",
    "test:profesional": "wdio run wdio.conf.js --cucumberOpts.tagExpression=@profesional", 
    "test:basic": "wdio run wdio.conf.js --cucumberOpts.tagExpression=@basic",
    "test:standard": "wdio run wdio.conf.js --cucumberOpts.tagExpression=@standard",
    "test:premium": "wdio run wdio.conf.js --cucumberOpts.tagExpression=@premium",
    "allure:generate": "allure generate reports/allure-results --clean -o reports/allure-report",
    "allure:open": "allure open reports/allure-report"
  }
}
